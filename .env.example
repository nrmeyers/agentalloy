# AgentAlloy — environment configuration
# Copy to .env and adjust as needed. All keys are AGENTALLOY_*.

# Service ports (final)
AGENTALLOY_SERVICE_PORT=48950
AGENTALLOY_EMBED_PORT=48951
AGENTALLOY_RERANK_PORT=48952
AGENTALLOY_MODEL_PORT=50001

# Model names
# MODEL is the main session model the proxy forwards to (upstream).
# INTERP_MODEL is the local orchestrator sidecar on MODEL_PORT.
AGENTALLOY_MODEL=minicpm5-2b
AGENTALLOY_INTERP_MODEL=minicpm5-2b
AGENTALLOY_EMBED_MODEL=LFM2.5-Embedding-350M
AGENTALLOY_RERANK_MODEL=LFM2.5-ColBERT-350M

# Upstream (proxy target). The local llama server ignores auth; set a real
# key only when pointing at a real upstream. Never commit one.
# AGENTALLOY_UPSTREAM_URL=http://localhost:50001
# AGENTALLOY_UPSTREAM_KEY=

# Interpreter budgets
AGENTALLOY_MAX_STEPS=6
AGENTALLOY_HARD_CAP=6
AGENTALLOY_MAX_TOKENS=2048
AGENTALLOY_THINKING_BUDGET=1024

# Retrieval
AGENTALLOY_SEARCH_K=10
AGENTALLOY_SKILL_CANDIDATES=30
AGENTALLOY_INSTRUCTION_BUDGET_CHARS=24000

# Paths
AGENTALLOY_REPO_ROOT=.
AGENTALLOY_EXTRA_REPOS=
AGENTALLOY_STATE_DUCK=./state.duck
AGENTALLOY_USAGE_DUCK=./usage.duck
AGENTALLOY_INDEX_DIR=./index
AGENTALLOY_CORPUS_DIR=./corpus
